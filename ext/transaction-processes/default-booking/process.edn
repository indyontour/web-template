;; beaway: Sharetribe's default-booking, edited to work WITHOUT Stripe / online payments.
;; Kept under the default-booking name so Console's "Calendar booking" listing types use it.
;; The original Sharetribe version is in Git history.
;;
;; - The traveler (customer) requests a date + seats, the host (provider) accepts or declines.
;; - Seats are held while the request is pending (create-pending-booking) and freed on decline/expire.
;; - Trips can be requested until departure, also when less than 12 hours away.
;; - A request (and its seat hold) expires 24 hours after it was made, or 12 hours before
;;   departure if that comes first (:transition/expire-before-cancellation-window).
;;   A request made less than 12 hours before departure can wait until departure
;;   (:transition/expire), since the 12-hour moment has already passed.
;; - The traveler can withdraw a pending request at any time before the host answers (seats are freed).
;; - The traveler can cancel an accepted booking until 12 hours before departure.
;;   After that the booking moves to :state/cancellation-closed. A booking accepted less than
;;   12 hours before departure moves there right away, so it can't be cancelled by the traveler.
;; - The host (and the operator) can cancel an accepted booking at any time until the trip completes.
;; - The trip completes automatically when the booking ends, then both sides can review for 7 days.
;; - Line items are still set (privileged) so the request page and emails can show
;;   "price × seats = total", paid to the host on the day. Nothing is charged.
;;
;; State and transition names from Sharetribe's default-booking are kept on purpose, so the
;; web template keeps working. To add instant booking later, add one more initial transition
;; (e.g. :transition/request-instant) that goes straight to :state/accepted.
{:format :v3,
 :transitions
 [{:name :transition/inquire,
   :actor :actor.role/customer,
   :actions [{:name :action/update-protected-data}],
   :to :state/inquiry}
  {:name :transition/request-payment,
   :actor :actor.role/customer,
   :actions
   [{:name :action/update-protected-data}
    {:name :action/create-pending-booking, :config {:type :time}}
    {:name :action/privileged-set-line-items}],
   :to :state/preauthorized,
   :privileged? true}
  {:name :transition/request-payment-after-inquiry,
   :actor :actor.role/customer,
   :actions
   [{:name :action/update-protected-data}
    {:name :action/create-pending-booking, :config {:type :time}}
    {:name :action/privileged-set-line-items}],
   :from :state/inquiry,
   :to :state/preauthorized,
   :privileged? true}
  {:name :transition/accept,
   :actor :actor.role/provider,
   :actions [{:name :action/accept-booking}],
   :from :state/preauthorized,
   :to :state/accepted}
  {:name :transition/operator-accept,
   :actor :actor.role/operator,
   :actions [{:name :action/accept-booking}],
   :from :state/preauthorized,
   :to :state/accepted}
  {:name :transition/decline,
   :actor :actor.role/provider,
   :actions [{:name :action/decline-booking}],
   :from :state/preauthorized,
   :to :state/declined}
  {:name :transition/operator-decline,
   :actor :actor.role/operator,
   :actions [{:name :action/decline-booking}],
   :from :state/preauthorized,
   :to :state/declined}
  {:name :transition/customer-withdraw-request,
   :actor :actor.role/customer,
   :actions [{:name :action/decline-booking}],
   :from :state/preauthorized,
   :to :state/withdrawn}
  {:name :transition/expire,
   :at
   {:fn/min
    [{:fn/plus
      [{:fn/timepoint [:time/first-entered-state :state/preauthorized]}
       {:fn/period ["PT24H"]}]}
     {:fn/timepoint [:time/booking-start]}]},
   :actions [{:name :action/decline-booking}],
   :from :state/preauthorized,
   :to :state/expired}
  {:name :transition/expire-before-cancellation-window,
   :at
   {:fn/ignore-if-past
    [{:fn/minus
      [{:fn/timepoint [:time/booking-start]} {:fn/period ["PT12H"]}]}]},
   :actions [{:name :action/decline-booking}],
   :from :state/preauthorized,
   :to :state/expired}
  {:name :transition/customer-cancel,
   :actor :actor.role/customer,
   :actions [{:name :action/cancel-booking}],
   :from :state/accepted,
   :to :state/cancelled}
  {:name :transition/provider-cancel,
   :actor :actor.role/provider,
   :actions [{:name :action/cancel-booking}],
   :from :state/accepted,
   :to :state/cancelled}
  {:name :transition/cancel,
   :actor :actor.role/operator,
   :actions [{:name :action/cancel-booking}],
   :from :state/accepted,
   :to :state/cancelled}
  {:name :transition/close-cancellation,
   :at
   {:fn/minus
    [{:fn/timepoint [:time/booking-start]} {:fn/period ["PT12H"]}]},
   :actions [],
   :from :state/accepted,
   :to :state/cancellation-closed}
  {:name :transition/provider-cancel-after-window,
   :actor :actor.role/provider,
   :actions [{:name :action/cancel-booking}],
   :from :state/cancellation-closed,
   :to :state/cancelled}
  {:name :transition/operator-cancel-after-window,
   :actor :actor.role/operator,
   :actions [{:name :action/cancel-booking}],
   :from :state/cancellation-closed,
   :to :state/cancelled}
  {:name :transition/complete,
   :at {:fn/timepoint [:time/booking-end]},
   :actions [],
   :from :state/cancellation-closed,
   :to :state/delivered}
  {:name :transition/operator-complete,
   :actor :actor.role/operator,
   :actions [],
   :from :state/cancellation-closed,
   :to :state/delivered}
  {:name :transition/review-1-by-provider,
   :actor :actor.role/provider,
   :actions [{:name :action/post-review-by-provider}],
   :from :state/delivered,
   :to :state/reviewed-by-provider}
  {:name :transition/review-2-by-provider,
   :actor :actor.role/provider,
   :actions
   [{:name :action/post-review-by-provider}
    {:name :action/publish-reviews}],
   :from :state/reviewed-by-customer,
   :to :state/reviewed}
  {:name :transition/review-1-by-customer,
   :actor :actor.role/customer,
   :actions [{:name :action/post-review-by-customer}],
   :from :state/delivered,
   :to :state/reviewed-by-customer}
  {:name :transition/review-2-by-customer,
   :actor :actor.role/customer,
   :actions
   [{:name :action/post-review-by-customer}
    {:name :action/publish-reviews}],
   :from :state/reviewed-by-provider,
   :to :state/reviewed}
  {:name :transition/expire-review-period,
   :at
   {:fn/plus
    [{:fn/timepoint [:time/booking-end]} {:fn/period ["P7D"]}]},
   :actions [],
   :from :state/delivered,
   :to :state/reviewed}
  {:name :transition/expire-provider-review-period,
   :at
   {:fn/plus
    [{:fn/timepoint [:time/booking-end]} {:fn/period ["P7D"]}]},
   :actions [{:name :action/publish-reviews}],
   :from :state/reviewed-by-customer,
   :to :state/reviewed}
  {:name :transition/expire-customer-review-period,
   :at
   {:fn/plus
    [{:fn/timepoint [:time/booking-end]} {:fn/period ["P7D"]}]},
   :actions [{:name :action/publish-reviews}],
   :from :state/reviewed-by-provider,
   :to :state/reviewed}],
 :notifications
 [{:name :notification/booking-new-request,
   :on :transition/request-payment,
   :to :actor.role/provider,
   :template :booking-new-request}
  {:name :notification/booking-new-request-after-inquiry,
   :on :transition/request-payment-after-inquiry,
   :to :actor.role/provider,
   :template :booking-new-request}
  {:name :notification/booking-accepted-request,
   :on :transition/accept,
   :to :actor.role/customer,
   :template :booking-accepted-request}
  {:name :notification/booking-operator-accepted-request-to-customer,
   :on :transition/operator-accept,
   :to :actor.role/customer,
   :template :booking-accepted-request}
  {:name :notification/booking-operator-accepted-request-to-provider,
   :on :transition/operator-accept,
   :to :actor.role/provider,
   :template :booking-operator-accepted-request}
  {:name :notification/booking-declined-request,
   :on :transition/decline,
   :to :actor.role/customer,
   :template :booking-declined-request}
  {:name :notification/booking-operator-declined-request-to-customer,
   :on :transition/operator-decline,
   :to :actor.role/customer,
   :template :booking-declined-request}
  {:name :notification/booking-operator-declined-request-to-provider,
   :on :transition/operator-decline,
   :to :actor.role/provider,
   :template :booking-operator-declined-request}
  {:name :notification/booking-expired-request,
   :on :transition/expire,
   :to :actor.role/customer,
   :template :booking-expired-request}
  {:name :notification/booking-expired-request-before-cancellation-window,
   :on :transition/expire-before-cancellation-window,
   :to :actor.role/customer,
   :template :booking-expired-request}
  {:name :notification/booking-request-withdrawn,
   :on :transition/customer-withdraw-request,
   :to :actor.role/provider,
   :template :booking-request-withdrawn}
  {:name :notification/booking-cancelled-by-customer,
   :on :transition/customer-cancel,
   :to :actor.role/provider,
   :template :booking-cancelled-by-customer}
  {:name :notification/booking-cancelled-by-provider,
   :on :transition/provider-cancel,
   :to :actor.role/customer,
   :template :booking-cancelled-by-provider}
  {:name :notification/booking-cancelled-by-provider-after-window,
   :on :transition/provider-cancel-after-window,
   :to :actor.role/customer,
   :template :booking-cancelled-by-provider}
  {:name :notification/review-period-start-provider,
   :on :transition/complete,
   :to :actor.role/provider,
   :template :booking-review-by-provider-wanted}
  {:name :notification/review-period-start-customer,
   :on :transition/complete,
   :to :actor.role/customer,
   :template :booking-review-by-customer-wanted}
  {:name :notification/review-period-start-provider-operator-complete,
   :on :transition/operator-complete,
   :to :actor.role/provider,
   :template :booking-review-by-provider-wanted}
  {:name :notification/review-period-start-customer-operator-complete,
   :on :transition/operator-complete,
   :to :actor.role/customer,
   :template :booking-review-by-customer-wanted}
  {:name :notification/review-by-provider-first,
   :on :transition/review-1-by-provider,
   :to :actor.role/customer,
   :template :booking-review-by-other-party-unpublished}
  {:name :notification/review-by-customer-first,
   :on :transition/review-1-by-customer,
   :to :actor.role/provider,
   :template :booking-review-by-other-party-unpublished}
  {:name :notification/review-by-provider-second,
   :on :transition/review-2-by-provider,
   :to :actor.role/customer,
   :template :booking-review-by-other-party-published}
  {:name :notification/review-by-customer-second,
   :on :transition/review-2-by-customer,
   :to :actor.role/provider,
   :template :booking-review-by-other-party-published}]}
